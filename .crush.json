{
  "$version": 2,
  "mcp": {
    "tinymem": {
      "args": ["mcp"],
      "command": "tinymem",
      "type": "stdio",
      "env": {
        "TINYMEM_LOGGING": "debug",
        "TINYMEM_METRICS_ENABLED": "true"
      },
      "timeout": 30000,
      "trust": false
    }
  },
  "providers": {
    "Ollama": {
      "name": "Ollama",
      "base_url": "http://localhost:8080/v1",
      "type": "openai-compat",
      "models": [
        {
          "name": "rnj",
          "id": "rnj-1",
          "context_window": 256000,
          "default_max_tokens": 20000
        }
      ]
    }
  }
}
